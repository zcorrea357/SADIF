# Copie para .env (o `make setup` faz isso) e ajuste os valores.
# O .env está no .gitignore — nunca faça commit dele.

# --- Infra (infra/docker-compose.yml) ---
MONGO_VERSION=7.0
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me
THEHIVE_VERSION=5.4
THEHIVE_PORT=9000
# Gere com: openssl rand -hex 32
THEHIVE_SECRET=

# --- Aplicação ---
# Qualquer chave de src/sadif/dataconfig/variables.json pode ser sobrescrita
# com o prefixo SADIF_. Valores JSON (listas/objetos) são interpretados.
SADIF_MONGODB_URL=mongodb://localhost:27017
SADIF_THEHIVE=http://localhost:9000/api
SADIF_THEHIVE_API_SERVICE=
# Preenchido pelo `make examples-bootstrap` com um repositório git local de clientes
# (o client_monitoring original é privado)
SADIF_GIT_REPO_CLIENT_MONITORING_URL=
SADIF_GIT_REPO_USER=
SADIF_GIT_REPO_TOKEN=
SADIF_SENTRYDSN=
